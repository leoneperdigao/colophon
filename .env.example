# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# This template is the ONLY committed env file.

# --- Adapter wiring -----------------------------------------------------------
# 'local' = real RabbitMQ/MinIO/Postgres (docker compose). 'memory' = in-memory
# fakes (tests / infra-free run).
APP_PROFILE=local

# --- Tenancy (token -> tenant_id; tenant is derived from the bearer, never
#     client-supplied). Use strong, unguessable tokens in real deployments. ----
TENANT_TOKENS=tokenA:tenant-a,tokenB:tenant-b

# --- RabbitMQ (scoped user, not the default guest) ----------------------------
RABBITMQ_USER=colophon
RABBITMQ_PASSWORD=change-me-rabbit

# --- Postgres -----------------------------------------------------------------
POSTGRES_USER=colophon
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=colophon

# --- MinIO (S3) ---------------------------------------------------------------
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio
MINIO_BUCKET=colophon-raw

# --- LLM (LiteLLM) ------------------------------------------------------------
# 'stub' = deterministic in-process annotator (offline; default for demos/CI).
# Real providers (chosen by the model string):
#   'anthropic/claude-3-5-haiku-latest'  (+ ANTHROPIC_API_KEY)
#   'gpt-4o-mini'                         (+ OPENAI_API_KEY)
#   'ollama/llama3.1'                     (+ LLM_API_BASE pointing at your Ollama host)
LLM_MODEL=stub
# LLM_API_BASE=http://host.docker.internal:11434   # e.g. host Ollama
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# --- Upload limit (bytes; untrusted input) ------------------------------------
MAX_UPLOAD_BYTES=10485760
